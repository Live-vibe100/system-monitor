{
  "name": "system-monitor",
  "version": "1.1.0",
  "description": "Windows tray app for live system stats",
  "main": "out/main/index.js",
  "author": "Live-vibe100",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "build": "electron-vite build",
    "dist": "npm run build && electron-builder --win nsis",
    "preview": "electron-vite preview"
  },
  "dependencies": {
    "menubar": "^9.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "systeminformation": "^5.23.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
